# Dependencias / build de los workspaces npm (packages/*, services/*, apps/*)
node_modules/
dist/
*.tsbuildinfo

# Config/tooling local de Claude Code -- no se versiona (decisión del
# usuario: agentes/permisos son configuración local de desarrollo, no parte
# del producto).
.claude/

# Imágenes de referencia del challenge (raíz del repo) -- material de
# contexto, no parte del código/producto.
/*.jpeg
/*.jpg
/*.png
/*.gif

# Material del nuevo dataset del hackathon (info del equipo, tutorial de
# acceso a la data) -- contexto local, nunca se versiona (puede tener
# credenciales/URLs de acceso al dataset).
/hacka-info/

# Variables de entorno reales -- nunca versionar secretos.
.env
.env.local
.env.*.local

# ml/: pipeline de entrenamiento/evaluación offline (Python, fuera de los
# workspaces npm). Nunca versionar el dataset real descargado (grande,
# datos del hackathon con términos de uso propios) ni el venv/artefactos
# binarios de modelos entrenados -- solo el código (ml/scripts, ml/src) y
# reportes en texto (ml/REPORT.md) se versionan. `!.gitkeep` mantiene la
# estructura de carpetas vacías versionada.
/ml/data/*
!/ml/data/.gitkeep
/ml/venv/
/ml/.venv/
/ml/models/*.pkl
/ml/models/*.onnx
/ml/.env
__pycache__/
*.pyc

# Logs
npm-debug.log*
*.log

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
