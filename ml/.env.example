# Copiar a ml/.env (gitignoreado, NUNCA versionar este archivo con valores
# reales) y completar con las credenciales temporales del hackathon, que
# vencen al cerrar el evento -- ver hacka-info/LATAM_Bank_Complete_Data_Dictionary.pdf
# (pág. 2). Nunca pegar estos valores en el chat/código/commits.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1

# Bucket + prefijo real del dataset del hackathon (ver la misma página del PDF).
HACKATHON_S3_BUCKET=
HACKATHON_S3_PREFIX=data/
